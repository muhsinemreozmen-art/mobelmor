# ========================================================================
# MOBELMOR APACHE / LITESPEED / CPANEL URL REWRITE KURALLARI
# ========================================================================

RewriteEngine On
RewriteBase /

# 1. SSL Yönlendirmesi (Canlı sunucu için)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Dosya veya Dizin Varsa Doğrudan Eriş
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. Kategori Sayfaları: /kategori/yatak-odasi -> kategori.php?c=yatak-odasi
RewriteRule ^kategori/([a-zA-Z0-9_-]+)/?$ kategori.php?c=$1 [QSA,L]

# 4. Ürün Detay Sayfaları: /urun/zen-modern-yatak-odasi-takimi-51 -> urun-detay.php?slug=$1
RewriteRule ^urun/([a-zA-Z0-9_-]+)-([0-9]+)/?$ urun-detay.php?id=$2&slug=$1 [QSA,L]

# 5. Genel Sayfalar: /sepet -> sepet.php
RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.php [QSA,L]
